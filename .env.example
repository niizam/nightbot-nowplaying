# Required: Your Nightbot API credentials
# Get these from: https://nightbot.tv/account/applications
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Optional: OAuth redirect URI (must match what you set in Nightbot app settings)
# Default: http://localhost:5771
REDIRECT_URI=http://localhost:5771

# Optional: Format string for song output
# Available variables: {title}, {artist}, {requester}
# Default: {title} - {artist}, requested by {requester}
FORMAT={title} - {artist}, requested by {requester}

# Optional: How often to check for new songs (in seconds)
# Default: 10
POLL_INTERVAL=10

# Optional: Name of the output text file
# Default: np.txt
OUTPUT_FILE=np.txt

# Note: The following variables are managed automatically by the application
# Do not edit them manually unless you know what you're doing
# ACCESS_TOKEN=
# REFRESH_TOKEN=
# EXPIRE_TIMESTAMP=
